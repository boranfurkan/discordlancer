# Names only. Real values go in .env (local) and Replit Secrets (live).
# Where to get each one: ~/Desktop/env-setup.md

# Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

# GitHub: a CLASSIC token with only the `repo` scope. A fine-grained token can't add
# collaborators to personal repos (403 even with Administration: Read and write).
GITHUB_TOKEN=
GITHUB_OWNER=boranfurkan

# Gemini (AI Studio key)
GEMINI_API_KEY=

# SurrealDB database
SURREAL_URL=
SURREAL_NAMESPACE=freelance
SURREAL_DATABASE=bot
SURREAL_USER=
SURREAL_PASS=

# SurrealDB Agent Memory
MEMORY_URL=
MEMORY_CONTEXT_ID=
MEMORY_API_KEY=

# Solana: receiving wallet (public address) and Helius mainnet RPC URL
SOLANA_WALLET_ADDRESS=
SOLANA_RPC_URL=

# Tavily
TAVILY_API_KEY=
