{
  "name": "discordlancer",
  "version": "0.1.0",
  "private": true,
  "description": "A Discord bot that runs freelance software projects from first chat to support.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.surql dist/db/schema.surql",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "commands:register": "tsx src/discord/register.ts",
    "claude:connect": "tsx scripts/claude-connect.ts",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@google/genai": "2.31.0",
    "@octokit/rest": "22.0.1",
    "@solana/kit": "8.5.0",
    "discord.js": "14.27.0",
    "qrcode": "1.5.4",
    "surrealdb": "2.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@surrealdb/node": "3.2.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@google/genai": false,
    "esbuild": false,
    "protobufjs": false
  }
}
